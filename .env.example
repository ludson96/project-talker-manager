# Porta em que o servidor HTTP irá rodar (padrão: 3000)
PORT=3000

# Ambiente de execução: 'development', 'test' ou 'production'
NODE_ENV=development

# URL de conexão com o banco de dados SQLite (embutido, idêntico ao H2)
# Não requer nenhum servidor externo de banco!
DATABASE_URL="file:./dev.db"

# Chave secreta para assinatura dos tokens JWT
JWT_SECRET="sua_chave_secreta_super_segura_aqui"

# Tempo de expiração do token JWT
JWT_EXPIRES_IN="7d"
